# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real credentials.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Path to the sibling consulate-rag-chatbot checkout ---
# This service imports that project's ingestion/review/fetcher/retrieval/
# generation code in-process (no HTTP calls between the two services, no
# copy-pasted logic) — see kb_admin/bootstrap.py.
CONSULATE_RAG_CHATBOT_PATH=../consulate-rag-chatbot

# --- PostgreSQL ---
# Same instance the chatbot uses — copy these from consulate-rag-chatbot's
# own .env. Do NOT point this at a separate database; the whole point of
# this service is to share the chatbot's operational DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rag_chatbot
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change_me_dev_only

# --- Qdrant ---
# Same instance the chatbot uses — copy these from consulate-rag-chatbot's
# own .env.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# --- Placeholder staff auth ---
# TODO: replace with real auth once login method is decided (options: plain
# username/password per staff member, or Google/Microsoft SSO)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_dev_only

# --- Phase 3: scheduled source recheck ---
RECHECK_INTERVAL_DAYS=7

# --- Phase 4: evaluation module (external LLM judge, offline eval only —
# never on the citizen-facing chat path) ---
# gemini reuses GEMINI_API_KEY below (zero incremental cost, free tier) --
# accepted trade-off: it's the same model family as GENERATION_BACKEND, so
# it may rate its own answers favorably. Switch to anthropic (and set
# EVAL_JUDGE_API_KEY) if a run's scores look suspiciously high/uniform.
EVAL_JUDGE_PROVIDER=gemini
EVAL_JUDGE_MODEL=gemini-2.5-flash
EVAL_JUDGE_API_KEY=

# --- Generation backend (Phase 4: needed so the eval module can call
# app.generation.service.answer_question(...) directly) — copy from
# consulate-rag-chatbot's own .env ---
GENERATION_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval reranking (Phase 4 follow-up) ---
# Safe to leave ON here even though the live chatbot's own .env leaves it
# OFF — eval calls resolve settings via THIS process's own .env, so this
# only affects kb_admin's eval runs, never the live chat. See
# app/retrieval/reranker.py and consulate-rag-chatbot/.env.example for why
# the live path can't afford this cross-encoder's latency on CPU-only
# hardware.
RETRIEVAL_RERANK=true
RETRIEVAL_RERANK_CANDIDATES=30
